# --- Environment and editor noise ---
.venv/
__pycache__/
.ipynb_checkpoints/

# --- Working folder with the reviews and third-party PDFs: never versioned. ---
artigo/

# --- The LaTeX source of the paper is kept outside the repository.
# 06_paper_outputs writes paper/numbers.tex and paper/tables/ for it. ---
paper/

# --- Raw collection: ~4.8 GB, fully reproducible by 01_data_collection ---
data/raw
dados/

# --- Training output: regenerated by 03_train, too large to version ---
# Models are the bulk; results/ and predictions/ are ~37 MB and still derived
# artifacts, so the whole tree stays out.
data/train/
data/train_fast/
*.joblib

# --- One-off notebook, deliberately untracked ---
# 03_train_fast is 03_train minus the EBM, saving models for only 8 of the 96
# combinations. It exists to get the paper's numbers out in one run before the
# deadline; the reference implementation is 03_train.
notebooks/03_train_fast.ipynb

# --- Decode checkpoints: intermediates of the .dbc expansion in 02_master.
# Regenerated by re-running the cell; versioning them buys nothing and costs
# 21 MB across 334 files.
data/master/*_checkpoints/

# --- Logs ---
*.log
